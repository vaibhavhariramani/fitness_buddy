rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function friendshipId(a, b) {
      return a < b ? a + '_' + b : b + '_' + a;
    }

    function friendshipDoc(otherUid) {
      return get(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, otherUid)));
    }

    function isAcceptedFriend(otherUid) {
      return isSignedIn()
        && exists(/databases/$(database)/documents/friendships/$(friendshipId(request.auth.uid, otherUid)))
        && friendshipDoc(otherUid).data.status == 'accepted';
    }

    function ownerProfile(uid) {
      return get(/databases/$(database)/documents/users/$(uid));
    }

    // Lightweight, broadly-readable directory used only for "find a friend by
    // email" lookups (see UserDirectoryEntry). Deliberately excludes weight,
    // macros, streak and privacy settings — those stay locked to the full
    // profile doc below.
    match /userDirectory/{uid} {
      allow read: if isSignedIn();
      allow write: if isOwner(uid);
    }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAcceptedFriend(uid);
      allow create: if isOwner(uid);
      allow update: if isOwner(uid);
      allow delete: if false;

      match /weightLogs/{logId} {
        allow read: if isOwner(uid)
          || (isAcceptedFriend(uid) && ownerProfile(uid).data.privacy.shareWeight == true);
        allow write: if isOwner(uid);
      }

      match /meals/{mealId} {
        allow read: if isOwner(uid)
          || (isAcceptedFriend(uid) && ownerProfile(uid).data.privacy.get('shareMeals', true) == true);
        allow write: if isOwner(uid);
      }

      match /workouts/{workoutId} {
        allow read: if isOwner(uid)
          || (isAcceptedFriend(uid) && ownerProfile(uid).data.privacy.shareWorkouts == true);
        allow write: if isOwner(uid);
      }

      match /personalRecords/{exerciseId} {
        allow read: if isOwner(uid)
          || (isAcceptedFriend(uid) && ownerProfile(uid).data.privacy.shareWorkouts == true);
        allow write: if isOwner(uid);
      }

      match /expenses/{expenseId} {
        allow read, write: if isOwner(uid);
      }

      match /workoutPlans/{planId} {
        allow read, write: if isOwner(uid);
      }

      match /weeklyRoutine/{docId} {
        allow read, write: if isOwner(uid);
      }

      match /weekSchedule/{weekId} {
        allow read, write: if isOwner(uid);
      }

      match /wellnessReminders/{reminderId} {
        allow read, write: if isOwner(uid);
      }

      match /customFoods/{foodId} {
        allow read, write: if isOwner(uid);
      }

      match /favoriteFoods/{foodId} {
        allow read, write: if isOwner(uid);
      }

      match /savedMeals/{mealId} {
        allow read, write: if isOwner(uid);
      }

      // 24h stories — gated by a single "share my story" toggle rather than
      // per-type (shareWeight/shareMeals), matching the on/off mental model
      // of a WhatsApp/Instagram status. Client writes are owner-only; the
      // daily-summary type is written by the scheduled Cloud Function via
      // the Admin SDK, which bypasses these rules entirely.
      match /stories/{storyId} {
        allow read: if isOwner(uid)
          || (isAcceptedFriend(uid) && ownerProfile(uid).data.privacy.get('shareStories', true) == true);
        allow write: if isOwner(uid);
      }

      match /userRecipes/{recipeId} {
        allow read, write: if isOwner(uid);
      }

      match /fcmTokens/{tokenId} {
        allow read, write: if isOwner(uid);
      }

      // Written only by Cloud Functions (Admin SDK bypasses these rules) —
      // the client can read its own and mark them read/delete, but never
      // fabricate one for itself.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(uid);
        allow create: if false;
      }
    }

    match /friendships/{friendshipId} {
      allow read: if isSignedIn() && request.auth.uid in resource.data.uids;
      allow create: if isSignedIn()
        && request.auth.uid in request.resource.data.uids
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedBy == request.auth.uid;
      allow update: if isSignedIn()
        && request.auth.uid in resource.data.uids
        && request.resource.data.status == 'accepted';
      allow delete: if isSignedIn() && request.auth.uid in resource.data.uids;
    }

    match /chats/{chatId} {
      allow read, update: if isSignedIn() && request.auth.uid in resource.data.participantUids;
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participantUids;
      allow delete: if false;

      match /messages/{messageId} {
        function chat() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data;
        }

        function chatParticipants() {
          return chat().participantUids;
        }

        // A direct chat has exactly the two participants fixed at creation
        // (see ChatRepo.getOrCreateDirectChat) — once either side blocks the
        // other, the friendship doc is gone, so this closes off the one
        // pre-existing chat doc a block can't otherwise revoke access to.
        // Group chats have no single "other" party to gate on this way.
        function canMessage() {
          return chat().type != 'direct'
            || isAcceptedFriend(chatParticipants()[0] == request.auth.uid
                ? chatParticipants()[1]
                : chatParticipants()[0]);
        }

        allow read: if isSignedIn() && request.auth.uid in chatParticipants();
        allow create: if isSignedIn()
          && request.auth.uid == request.resource.data.senderUid
          && request.auth.uid in chatParticipants()
          && canMessage();
        allow update, delete: if false;
      }
    }

    // Seeded, mostly-static dataset for the rule-based food recommendation
    // feature. Public read, no client writes — seed via the Firebase console
    // or `firebase firestore:import` (see DEPLOYMENT.md).
    match /recipes/{recipeId} {
      allow read: if true;
      allow write: if false;
    }

    // Moderation trail (Guideline 1.2) — a user can only ever file a report
    // as themselves, and never read, edit, or delete any report, including
    // their own. Reviewed via the Firebase console.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterUid == request.auth.uid;
      allow read, update, delete: if false;
    }
  }
}
